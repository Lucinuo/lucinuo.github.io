{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lucinuo.github.io/bearing/data-schema.json",
  "title": "Bearing Data v4",
  "description": "The portable data contract shared by Bearing web exports and future native clients.",
  "type": "object",
  "required": ["version", "updatedAt", "observations", "priorities", "directionNotes", "nextMoves", "lifeOverviews"],
  "properties": {
    "app": { "const": "Bearing" },
    "format": { "const": "lucinuo.bearing.data" },
    "version": { "const": 4 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    },
    "priorities": {
      "type": "array",
      "items": { "$ref": "#/$defs/priority" }
    },
    "directionNotes": {
      "type": "array",
      "items": { "$ref": "#/$defs/directionNote" }
    },
    "nextMoves": {
      "type": "array",
      "items": { "$ref": "#/$defs/nextMove" }
    },
    "lifeOverviews": {
      "type": "array",
      "items": { "$ref": "#/$defs/lifeOverview" }
    },
    "legacyImport": {
      "type": ["object", "null"]
    }
  },
  "$defs": {
    "recordBase": {
      "type": "object",
      "required": ["id", "content", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "observation": {
      "allOf": [
        { "$ref": "#/$defs/recordBase" },
        {
          "type": "object",
          "required": ["date"],
          "properties": { "date": { "type": "string", "format": "date" } }
        }
      ]
    },
    "priority": {
      "allOf": [
        { "$ref": "#/$defs/recordBase" },
        {
          "type": "object",
          "required": ["observationId"],
          "properties": { "observationId": { "type": "string" } }
        }
      ]
    },
    "directionNote": {
      "allOf": [
        { "$ref": "#/$defs/recordBase" },
        {
          "type": "object",
          "required": ["periodStart"],
          "properties": { "periodStart": { "type": "string", "format": "date" } }
        }
      ]
    },
    "nextMove": {
      "allOf": [
        { "$ref": "#/$defs/recordBase" },
        {
          "type": "object",
          "required": ["priorityId", "status"],
          "properties": {
            "priorityId": { "type": "string" },
            "status": { "enum": ["open", "done"] }
          }
        }
      ]
    },
    "lifeOverview": {
      "type": "object",
      "required": ["id", "date", "perspectives", "focus", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "perspectives": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "knowledge": { "type": "string", "minLength": 1 },
            "expression": { "type": "string", "minLength": 1 },
            "aesthetic": { "type": "string", "minLength": 1 },
            "solitude": { "type": "string", "minLength": 1 },
            "emotion": { "type": "string", "minLength": 1 }
          }
        },
        "focus": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
